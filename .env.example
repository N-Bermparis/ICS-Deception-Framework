# ============================================================
# ICS Deception Framework
# Example environment configuration
# ============================================================

# Mutable runtime state
ICS_DECEPTION_RUNTIME_DIR=runtime

# Shared JSONL event log
ICS_DECEPTION_EVENT_LOG=runtime/events.jsonl

# Approved PCAP directory
ICS_DECEPTION_PCAP_DIR=data/pcaps

# ============================================================
# Post-quantum evidence
# ============================================================

# Disabled by default.
# Supported modes include disabled, sign, dual and verify-only.
ICS_PQC_EVIDENCE_MODE=disabled

ICS_PQC_NODE_ID=
ICS_PQC_KEY_ID=
ICS_PQC_PRIVATE_KEY=

ICS_PQC_EVIDENCE_LOG=runtime/pqc/evidence.jsonl
ICS_PQC_STATE=runtime/pqc/state.json

# Optional backend override
ICS_PQC_BACKEND=

# Optional alternative OpenSSL executable
ICS_PQC_OPENSSL=

# Development/research mode by default
ICS_PQC_PRODUCTION=0
